---
import 'photoswipe/style.css';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AuthorCard from '@/components/AuthorCard.astro';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import Giscus from '@/components/Giscus.astro';
import Header from '@/components/Header.astro';
import TagList from '@/components/TagList.astro';
import { Separator } from '@/components/ui/separator';

type Props = Omit<CollectionEntry<'blog'>['data'], 'author' | 'tags' | 'draft'> & {
	author?: CollectionEntry<'authors'> | undefined;
	tags?: string[];
	draft?: boolean;
};

const { title, description, pubDate, updatedDate, heroImage, author, tags } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
			<article class="space-y-10">
				{heroImage && (
					<div class="overflow-hidden rounded-2xl border border-border/60 shadow-sm">
						<Image width={1200} height={630} src={heroImage} alt={title} class="h-full w-full object-cover" />
					</div>
				)}

				<div class="space-y-4 text-center">
					<div class="flex flex-wrap items-center justify-center gap-3 text-xs uppercase tracking-[0.3em] text-muted-foreground">
						<span>
							<FormattedDate date={pubDate} />
						</span>
						{updatedDate && (
							<span class="text-muted-foreground/80">
								Updated <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					<h1 class="text-4xl font-semibold text-foreground sm:text-5xl">{title}</h1>
					{tags && tags.length > 0 && (
						<div class="flex justify-center">
							<TagList tags={tags} />
						</div>
					)}
				</div>

				<Separator />

				<div class="prose prose-lg prose-custom dark:prose-invert max-w-none">
					<slot />
				</div>
				{author && <AuthorCard author={author} />}
				<Giscus />
			</article>
		</main>
		<Footer />
		<script>
			import PhotoSwipeLightbox from 'photoswipe/lightbox';

			let lightbox: PhotoSwipeLightbox | undefined;
			let listeners: AbortController | undefined;

			function cleanup() {
				listeners?.abort();
				lightbox?.destroy();
				lightbox = undefined;
			}

			document.addEventListener('astro:before-swap', cleanup);
			document.addEventListener('astro:page-load', () => {
				cleanup();
				listeners = new AbortController();
				const { signal } = listeners;
				const images = [...document.querySelectorAll<HTMLImageElement>('.prose img')].filter(
					(image) => !image.closest('.mermaid, svg, .icon, [data-no-zoom]')
						&& !/\.svg(?:[?#]|$)|^data:image\/svg|\/icons?\//i.test(image.currentSrc || image.src),
				);
				if (!images.length) return;

				const slideData = (image: HTMLImageElement) => ({
					src: image.currentSrc || image.src,
					// Already-loaded inline image used as the placeholder during the open zoom animation.
					msrc: image.currentSrc || image.src,
					width: image.naturalWidth || Number(image.getAttribute('width')),
					height: image.naturalHeight || Number(image.getAttribute('height')),
					alt: image.alt,
					caption: image.closest('figure')?.querySelector('figcaption')?.textContent?.trim() || image.alt,
					element: image,
				});
				const dataSource = images.map(slideData);
				const gallery = new PhotoSwipeLightbox({
					dataSource,
					pswpModule: () => import('photoswipe'),
					// Plain mouse wheel / trackpad scroll zooms instead of panning.
					wheelToZoom: true,
				});
				lightbox = gallery;
				gallery.on('uiRegister', () => {
					gallery.pswp?.ui?.registerElement({
						name: 'caption',
						appendTo: 'root',
						onInit: (element, pswp) => {
							const updateCaption = () => {
								element.textContent = pswp.currSlide?.data.caption || '';
								element.hidden = !element.textContent;
							};
							pswp.on('change', updateCaption);
							updateCaption();
						},
					});
				});
				gallery.init();

				images.forEach((image, index) => {
					image.tabIndex = 0;
					image.setAttribute('role', 'button');
					image.setAttribute('aria-label', image.alt ? `Enlarge image: ${image.alt}` : 'Enlarge image');
					image.dataset.zoomable = '';
					const open = () => {
						// Lazy images and responsive sources may have loaded since page-load.
						dataSource.splice(0, dataSource.length, ...images.map(slideData));
						image.focus();
						gallery.loadAndOpen(index);
					};
					image.addEventListener('click', (event) => {
						event.preventDefault();
						open();
					}, { signal });
					image.addEventListener('keydown', (event) => {
						if (event.key === 'Enter' || event.key === ' ') {
							event.preventDefault();
							open();
						}
					}, { signal });
				});
			});
		</script>
	</body>
</html>
